+        {
+            // Register writes, an A+D GIF packet and a PACKED vertex packet, queued on the GS
+            // thread, must leave GS memory byte-identical to running them inline.
+            auto drawScene = [](GS &gs)
+            {
+                constexpr uint64_t kFrame = (0ull << 0) | (1ull << 16) | (static_cast<uint64_t>(GS_PSM_CT32) << 24);
+                gs.writeRegister(GS_REG_FRAME_1, kFrame);
+                gs.writeRegister(GS_REG_ZBUF_1, (1ull << 32));
+                gs.writeRegister(GS_REG_SCISSOR_1, (63ull << 16) | (63ull << 48));
+                gs.writeRegister(GS_REG_XYOFFSET_1, 0ull);
+                gs.writeRegister(GS_REG_TEST_1, 0x30000ull);
+                for (uint32_t i = 0; i < 24u; ++i)
+                {
+                    // A+D: PRIM (triangle, Gouraud, alpha blend on), then three RGBAQ/XYZ2 pairs.
+                    std::vector<uint64_t> qw;
+                    auto ad = [&](uint64_t reg, uint64_t value)
+                    {
+                        qw.push_back(value);
+                        qw.push_back(reg);
+                    };
+                    const uint64_t nloop = 7u;
+                    qw.push_back(nloop | (1ull << 15) | (1ull << 60)); // EOP, PACKED, NREG=1
+                    qw.push_back(0xEull);                               // A+D
+                    ad(GS_REG_PRIM, static_cast<uint64_t>(GS_PRIM_TRIANGLE) | (1ull << 3) | (1ull << 6));
+                    const uint16_t x0 = static_cast<uint16_t>((i * 37u % 50u) << 4);
+                    const uint16_t y0 = static_cast<uint16_t>((i * 23u % 50u) << 4);
+                    for (uint32_t v = 0; v < 3u; ++v)
+                    {
+                        const uint64_t rgba = (0x30u + 40u * v) | ((0x90u + 7u * i) & 0xFFu) << 8 | (0x20u * v) << 16 | (0x60ull << 24);
+                        ad(GS_REG_RGBAQ, rgba | (0x3F800000ull << 32));
+                        const uint16_t x = static_cast<uint16_t>(x0 + (v == 1u ? 0xC0u : 0u));
+                        const uint16_t y = static_cast<uint16_t>(y0 + (v == 2u ? 0xB0u : 0u));
+                        ad(GS_REG_XYZ2, static_cast<uint64_t>(x) | (static_cast<uint64_t>(y) << 16) | (static_cast<uint64_t>(i) << 32));
+                    }
+                    std::vector<uint8_t> packet(qw.size() * 8u);
+                    std::memcpy(packet.data(), qw.data(), packet.size());
+                    if ((i & 1u) == 0u)
+                        gs.processGIFPacket(packet.data(), static_cast<uint32_t>(packet.size()));
+                    else if (!gs.processNativePackedGIFPacket(packet.data(), static_cast<uint32_t>(packet.size())))
+                        gs.processGIFPacket(packet.data(), static_cast<uint32_t>(packet.size()));
+                }
+            };
+
+            std::vector<uint8_t> syncVram(PS2_GS_VRAM_SIZE, 0u);
+            std::vector<uint8_t> asyncVram(PS2_GS_VRAM_SIZE, 0u);
+            {
+                GS gs;
+                gs.init(syncVram.data(), static_cast<uint32_t>(syncVram.size()), nullptr);
+                drawScene(gs);
+            }
+            {
+                GS gs;
+                gs.init(asyncVram.data(), static_cast<uint32_t>(asyncVram.size()), nullptr);
+                gs.setAsync(true);
+                t.IsTrue(gs.isAsync(), "setAsync(true) should start the GS thread");
+                drawScene(gs);
+                gs.waitIdle();
+                gs.setAsync(false);
+            }
+            bool anyDrawn = false;
+            for (size_t i = 0; i < 64u * 64u * 4u; ++i)
+                anyDrawn = anyDrawn || syncVram[i] != 0u;
+            t.IsTrue(anyDrawn, "the scene should draw something");
+            t.IsTrue(syncVram == asyncVram, "asynchronous GS memory should match the synchronous GS byte for byte");
+        });
